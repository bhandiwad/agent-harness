{
  "tool": {
    "name": "datafusion_search",
    "version": "v1",
    "owner": "context-team",
    "transport": "rest",
    "effect": "read",
    "permission": "context:read",
    "approval_required": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "structured",
                  "document"
                ]
              },
              "rows": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "maxProperties": 32,
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              },
              "metadata": {
                "type": "object",
                "maxProperties": 16,
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "reference",
              "version",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "binding": {
    "endpoint": "https://datafusion-adapter.example.invalid",
    "operations": {
      "datafusion_search": "/context/search"
    }
  },
  "subject_token_files": {
    "REPLACE_WITH_IDP_SUBJECT": "tokens/datafusion-user.token"
  }
}
