{
  "tool": {
    "name": "datafusion_authorize",
    "version": "v1",
    "owner": "context-team",
    "transport": "rest",
    "effect": "read",
    "permission": "context:read",
    "approval_required": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "reference",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "authorized_sources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "reference",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "authorized_sources"
      ],
      "additionalProperties": false
    },
    "timeout_seconds": 10
  },
  "binding": {
    "endpoint": "https://datafusion-adapter.example.invalid",
    "operations": {
      "datafusion_authorize": "/context/authorize"
    }
  },
  "subject_token_files": {
    "REPLACE_WITH_IDP_SUBJECT": "tokens/datafusion-user.token"
  }
}
